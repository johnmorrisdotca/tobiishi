{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src"
  ]
}